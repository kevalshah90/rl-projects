# Python and uv
# .venv is a symlink to ~/.venvs/kernelbook-rl (outside iCloud-synced Documents, which
# hides .pth files and breaks the editable install). No trailing slash: a symlink isn't a dir.
.venv
__pycache__/
*.pyc
.pytest_cache/

# Generated by the pipeline: always regenerable with one command, so never committed.
# (Comments must be on their own line: gitignore has no end-of-line comments.)
# data/    stats, kept/dropped rows, validation and baseline results, splits
# tasks/   Harbor task folders (up to ~18k) + registry.json
# outputs/ checkpoints and run logs from the RL loops
data/
tasks/
outputs/

# Local secrets
.env
